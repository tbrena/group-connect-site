# ─── Grupo ───────────────────────────────────────────────────────────────────
# Nome do grupo, como aparece no WhatsApp (um trecho basta; ignora maiúsculas).
# Rode `npm run grupos` para ver os nomes e os JIDs.
GROUP_NAME=Preço Ninja
# Mais preciso: o JID do grupo (aparece em `npm run grupos`). Tem prioridade sobre
# GROUP_NAME. Para postar em mais de um grupo, separe os JIDs por vírgula.
GROUP_JID=

# ─── Ritmo (anti-banimento: vá devagar no começo) ────────────────────────────
# 1 post a cada X minutos (o bot varia ±25% para não parecer robô).
INTERVALO_MINUTOS=6
# Teto de posts por hora, somando tudo.
MAX_POR_HORA=10
# Horário de Brasília em que o bot posta (inicial-final, 24h). 08-23 = das 8h às 22h59.
ACTIVE_HOURS=08-23

# ─── O que postar ────────────────────────────────────────────────────────────
# Lojas: ml, shopee ou as duas.
LOJAS=ml,shopee
# 1 = posta também os cupons; 0 = só ofertas.
CUPONS=1
# Não posta item da fila com mais de X minutos (o preço pode ter mudado).
MAX_IDADE_MINUTOS=180

# ─── Avançado ────────────────────────────────────────────────────────────────
# Fila publicada pelo bot do GitHub (não precisa mudar).
FILA_URL=https://raw.githubusercontent.com/tbrena/preco-ninja-dados/main/whatsapp.json
