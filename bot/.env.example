# ─── WhatsApp ────────────────────────────────────────────────────────────────
# Nome do grupo, exatamente como aparece no WhatsApp (não precisa ser completo,
# busca ignora maiúsculas). Rode `npm run groups` para ver os nomes disponíveis.
GROUP_NAME=Preço Ninja
# Alternativa mais precisa: o JID do grupo (também aparece em `npm run groups`).
# Se preenchido, tem prioridade sobre GROUP_NAME.
GROUP_JID=

# ─── Afiliado Mercado Livre ──────────────────────────────────────────────────
# Gere qualquer link no painel de afiliados (Gerador de links) e copie os dois
# parâmetros que aparecem na URL: ...?matt_tool=XXXXXXXX&matt_word=seunome
ML_AFFILIATE_TOOL=
ML_AFFILIATE_WORD=

# ─── API oficial do Mercado Livre (recomendado) ──────────────────────────────
# 1. Crie um aplicativo em https://developers.mercadolivre.com.br (Minhas aplicações)
#    - URL de redirecionamento: https://ofertaninja.online/ml-callback
#    - Escopos: read + offline_access
# 2. Copie a Secret Key para cá (o App ID já está preenchido; nunca commite a Secret).
# 3. Rode `npm run ml:auth` uma vez para autorizar.
ML_APP_ID=3101347879633536
ML_APP_SECRET=
ML_REDIRECT_URI=https://ofertaninja.online/ml-callback

# auto = API se estiver autorizada, senão a página de ofertas (padrão)
# api  = só a API   |   page = só a página de ofertas
ML_SOURCE=auto

# Buscas na API, separadas por "|". Cada uma é uma query string da busca do ML:
#   category=MLB1051        celulares        category=MLB1648   informática
#   category=MLB1000        eletrônicos      category=MLB5726   eletrodomésticos
#   category=MLB1574        casa e móveis    category=MLB1144   games
#   q=smart tv 50           busca por texto  shipping=free      só frete grátis
# O desconto mínimo (MIN_DISCOUNT_PERCENT) é aplicado automaticamente.
# Vazio = celulares, informática, eletrônicos, eletrodomésticos, casa e games.
ML_API_SEARCHES=

# ─── Página de ofertas (reserva, ou ML_SOURCE=page) ──────────────────────────
# Uma ou mais páginas de ofertas do ML, separadas por vírgula. Exemplos:
#   https://www.mercadolivre.com.br/ofertas
#   https://www.mercadolivre.com.br/ofertas?page=2
#   https://www.mercadolivre.com.br/ofertas?category=MLB1051   (celulares)
#   https://www.mercadolivre.com.br/ofertas?category=MLB1648   (informática)
ML_OFFERS_URLS=https://www.mercadolivre.com.br/ofertas,https://www.mercadolivre.com.br/ofertas?page=2

# ─── Regras de postagem ──────────────────────────────────────────────────────
# Só posta ofertas com desconto igual ou maior que isso (%).
MIN_DISCOUNT_PERCENT=20
# Intervalo entre postagens, em minutos (o bot varia ±20% para parecer natural).
POST_INTERVAL_MINUTES=30
# Quantas ofertas por rodada.
POSTS_PER_RUN=1
# Horário em que o bot posta (hora inicial-hora final, 24h). 08-22 = das 8h às 21h59.
ACTIVE_HOURS=08-22
# Não repete o mesmo produto por este número de dias.
REPOST_AFTER_DAYS=7
# Palavras que, se aparecerem no título, fazem o bot pular a oferta (separadas por vírgula).
BLOCKED_WORDS=

# ─── Assinatura da mensagem ──────────────────────────────────────────────────
BRAND_NAME=Preço Ninja
SITE_URL=https://ofertaninja.online

# ─── Depuração ───────────────────────────────────────────────────────────────
# 1 = salva o HTML de cada página de ofertas em data/debug-*.html (útil se der 0 ofertas).
DEBUG_HTML=0
