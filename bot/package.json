{
  "name": "preco-ninja-bot",
  "private": true,
  "type": "module",
  "description": "Posta ofertas do Mercado Livre automaticamente no grupo do WhatsApp do Preço Ninja",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "tsx src/index.ts",
    "groups": "tsx src/cli.ts groups",
    "ml:auth": "tsx src/cli.ts ml-auth",
    "ml:test": "tsx src/cli.ts ml",
    "post:dry": "tsx src/cli.ts post --dry",
    "post:test": "tsx src/cli.ts post",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@hapi/boom": "^10.0.1",
    "@whiskeysockets/baileys": "^6.7.16",
    "cheerio": "^1.0.0",
    "dotenv": "^16.4.7",
    "jimp": "0.16.13",
    "pino": "^9.6.0",
    "qrcode-terminal": "^0.12.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.0",
    "@types/qrcode-terminal": "^0.12.2",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3"
  }
}
